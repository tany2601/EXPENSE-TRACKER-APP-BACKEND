generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  phone        String?
  avatar       String?
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions           Transaction[]
  contacts               Contact[]
  categories             Category[]
  sessions               Session[]
  deviceTokens           DeviceToken[]
  notificationDeliveries NotificationDelivery[]
  notificationPreference NotificationPreference?
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  amount    Float
  type      TransactionType
  category  String

  date      DateTime
  dueDate   DateTime?
  isPaid    Boolean @default(true)

  clientName    String?
  projectTitle  String?
  tags          String[] @default([])
  notes         String?
  receiptImage  String?
  receiptPublicId  String?

  splits    TransactionSplit[]

  clientUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt         DateTime?
  deletedByDeviceId String?
  reminderDismissedAt DateTime?
}

model TransactionSplit {
  id             String   @id @default(uuid())
  transactionId  String
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  participantId  String
  participant    Contact @relation(fields: [participantId], references: [id])

  amount         Float
  isPaid         Boolean @default(false)

  createdAt      DateTime @default(now())
}

model Contact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String

  splits    TransactionSplit[]

  clientUpdatedAt DateTime?
  updatedAt       DateTime @updatedAt

  deletedAt         DateTime?
  deletedByDeviceId String?

  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id        String   @id @default(uuid())
  name      String
  iconName  String
  color     String
  isDefault Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  clientUpdatedAt DateTime?
  updatedAt       DateTime @updatedAt

  deletedAt         DateTime?
  deletedByDeviceId String?

  @@unique([name, userId])
}

model EmailOtp {
  email      String
  type       String
  otpHash    String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@id([email, type])
}

model OtpThrottle {
  email String
  type  String

  failedVerifyCount Int      @default(0)
  verifyLockedUntil DateTime?

  sendCount         Int      @default(0)
  sendWindowStart   DateTime?
  sendLockedUntil   DateTime?

  updatedAt DateTime @updatedAt

  @@id([email, type])
}

model LoginThrottle {
  email           String   @id

  failedCount     Int      @default(0)
  windowStart     DateTime?
  lockedUntil     DateTime?

  updatedAt       DateTime @updatedAt
}

model Session {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String

  deviceId        String?
  userAgent       String?
  ip              String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime
  revokedAt       DateTime?

  @@index([userId])
  @@index([deviceId])
}

// ─── Notification Engine ────────────────────────────────────────────

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String
  fcmToken  String
  platform  String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
}

model NotificationTemplate {
  id   String @id @default(uuid())
  name String

  type            String
  triggerCategory String

  title String
  body  String

  condition String?

  deepLinkScreen String?
  deepLinkData   String?

  dedupWindowDays Int @default(7)

  isActive  Boolean @default(true)
  priority  String  @default("NORMAL")
  sortOrder Int     @default(0)

  deliveries NotificationDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationDelivery {
  id         String @id @default(uuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String?
  template   NotificationTemplate? @relation(fields: [templateId], references: [id])

  dedupKey String @unique

  title String
  body  String

  channel String @default("PUSH")
  status  String @default("SENT")

  sentAt   DateTime  @default(now())
  openedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

model NotificationPreference {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pushEnabled     Boolean @default(true)
  emailEnabled    Boolean @default(false)

  insightsEnabled    Boolean @default(true)
  alertsEnabled      Boolean @default(true)
  engagementEnabled  Boolean @default(true)

  quietHoursStart Int?
  quietHoursEnd   Int?

  updatedAt DateTime @updatedAt
}
